[Unit]
Description=CFSM low-traffic public network monitor on deb
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
ExecStart=/usr/bin/python3 /opt/cfsm-netwatch/netwatch.py run
Restart=on-failure
RestartSec=15
TimeoutStopSec=35
KillMode=mixed
Nice=10
CPUQuota=20%
MemoryMax=192M
TasksMax=64
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=multi-user.target
